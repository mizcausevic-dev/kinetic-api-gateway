{
  "name": "kinetic-api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Synthetic Express API for explainable SaaS lead scoring and sample account and campaign data.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
