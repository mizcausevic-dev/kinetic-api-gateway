  "engines": {
    "node": ">=20"
  },
  "puppeteer": {
    "skipDownload": true
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.17.0",
    "supertest": "^7.1.4"
  }
