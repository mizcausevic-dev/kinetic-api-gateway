PORT=3000
SERVICE_NAME=Kinetic API Gateway

# Disabled by default. Keep real credentials in an untracked .env or deployment secret store.
GATEWAY_ENABLED=0
# JSON array of {"id":"...","tenantId":"...","tokenHash":"<64 hex SHA-256 digest>","scopes":["scores:read","deliveries:write","deliveries:read","leads:delete"]}.
# This file intentionally contains no usable client or credential.
GATEWAY_CLIENTS_JSON=
GATEWAY_SOURCE_URL=
GATEWAY_SOURCE_TOKEN=
GATEWAY_DELIVERY_URL=
# Gateway startup requires at least 32 UTF-8 bytes; use a secret manager, not this file.
GATEWAY_DELIVERY_SECRET=
# Keep source deletion disabled unless the configured source and data owner support it.
GATEWAY_ALLOW_DELETE=0
